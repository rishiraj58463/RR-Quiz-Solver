{
  "manifest_version": 3,
  "name": "RR Quiz Solver",
  "version": "2.0.0",
  "description": "RR Quiz Solver - Powered by Rishi Raj",
  "author": "Rishi Raj",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "RR Quiz Solver"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.coursera.org/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://*.coursera.org/*",
    "https://api.groq.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://quizsolver.infinityfreeapp.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "pageBridge.js",
        "icons/*",
        "get-key.html",
        "get-key.js"
      ],
      "matches": [
        "https://*.coursera.org/*"
      ]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
